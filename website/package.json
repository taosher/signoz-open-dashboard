{
  "name": "@signoz-open-dashboard/website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy:workers": "wrangler deploy --config deploy/wrangler.jsonc",
    "deploy:workers:dry-run": "wrangler deploy --config deploy/wrangler.jsonc --dry-run",
    "deploy:pages:create": "wrangler pages project create signoz-open-dashboard-website --production-branch=main",
    "deploy:pages": "wrangler pages deploy dist/client --project-name=signoz-open-dashboard-website",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}

# signoz-open-dashboard 本地环境变量模板（设计文档 §6.1）。
# 用法：复制为 `.env`（生产模式本地启动）或 `.env.development`（dev 模式），
# 两个文件均已被 gitignore，只留本地，不入库。

# 唯一 Upstream（必填，必须 http(s)，不允许 URL 覆盖，防 SSRF）
SIGNOZ_BASE_URL=http://192.168.10.2:30303

# 默认 Key（可选，可被 URL apiKey 覆盖；为空仅 warn）
# 测试 Key 见 docs/product-tech-design-v1.0.md 附录 A，不要写进任何入库文件
SIGNOZ_API_KEY=

# NestJS 监听端口
PORT=8080

# queryRange 超时（毫秒）；看板 meta 接口超时
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_META_TIMEOUT_MS=10000

# 日志级别：debug/info/warn/error
LOG_LEVEL=info

# CORS：完全公开是有意为之（设计文档 §10），不要改成收紧
CORS_ORIGIN=*

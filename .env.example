# signoz-open-dashboard local environment template (design doc §6.1).
# Usage: copy to `.env` (local production start) or `.env.development` (dev mode),
# both files are already gitignored, keep them local, do not commit.

# Single Upstream (required, must be http(s), URL override not allowed, SSRF protection)
SIGNOZ_BASE_URL=http://192.168.10.2:30303

# Default key (optional, can be overridden by the URL apiKey; empty only warns)
# For the test key see docs/product-tech-design.md Appendix A, never write it into any committed file
SIGNOZ_API_KEY=

# NestJS listen port
PORT=8080

# queryRange timeout (ms); dashboard meta interface timeout
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_META_TIMEOUT_MS=10000

# Log level: debug/info/warn/error
LOG_LEVEL=info

# CORS: fully open is intentional (design doc §10), do not tighten it
CORS_ORIGIN=*

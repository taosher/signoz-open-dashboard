    "@nestjs/serve-static": "4.0.2",
    "@nestjs/throttler": "6.2.1",
    "@nestjs/terminus": "10.2.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "joi": "17.13.3",
    "prom-client": "15.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.14.0",
    "@types/supertest": "6.0.2",
